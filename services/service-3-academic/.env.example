# Copier vers .env (NE JAMAIS commiter .env)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=academic_db
DB_USER=unitrack
DB_PASSWORD=unitrack
DB_HOST=localhost
DB_PORT=5432

# JWT emis par le Service 1 (Auth) : meme secret et meme algorithme
JWT_SECRET=change-me-same-as-service-1
JWT_ALGORITHM=HS256
JWT_USER_ID_CLAIM=user_id
JWT_ROLE_CLAIM=role

# Mode dev : accepte les en-tetes X-User-Id / X-User-Role sans JWT (Postman)
# IMPORTANT : passer a False en production !
AUTH_DEV_MODE=True

# RabbitMQ (Communication asynchrone - Exigence WAMS 2.4 & CDC 2.3)
RABBITMQ_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=unitrack.events

# Fallback HTTP optionnel vers Service 5
NOTIFICATION_URL=

# Consul (Service Registry / Discovery - Exigence WAMS 2.5 & CDC 2.3)
CONSUL_ENABLED=true
CONSUL_HOST=127.0.0.1
CONSUL_PORT=8500
SERVICE_ID=service-3-academic-8003
SERVICE_NAME=service-3-academic
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8003
