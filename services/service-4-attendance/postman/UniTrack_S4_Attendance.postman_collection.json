        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "const l = pm.response.json(); if (l.length) pm.collectionVariables.set(\"seanceId\", l[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Enseignant : démarrer la séance",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/attendance/v1/seances/{{seanceId}}/start/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "attendance",
            "v1",
            "seances",
            "{{seanceId}}",
            "start"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 + code 6 chiffres\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().code).to.match(/^\\d{6}$/); });",
              "pm.collectionVariables.set(\"code\", pm.response.json().code);"
            ]
          }
        }
      ]
    },
    {
      "name": "Étudiant : saisir un mauvais code → 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          },
          {
            "key": "Content-Type",
