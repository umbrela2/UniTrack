            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "attendance",
            "v1",
            "seances",
            "{{seanceId}}",
            "check-in"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"code\": \"000000\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"invalid_code\", () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error).to.eql(\"invalid_code\"); });"
            ]
          }
        }
      ]
    },
