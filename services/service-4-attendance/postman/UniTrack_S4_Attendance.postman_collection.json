  "item": [
    {
      "name": "Sans token → 401",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer "
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/attendance/v1/seances/today/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "attendance",
            "v1",
            "seances",
            "today"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
