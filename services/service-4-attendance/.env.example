# ---- Copier en .env (JAMAIS commité) puis adapter ----
DJANGO_SECRET_KEY=change-me-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
TIME_ZONE=Africa/Algiers

# Base attendance_db (PostgreSQL de CE serveur)
DB_NAME=attendance_db
DB_USER=attendance
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# JWT émis par S1 (mêmes valeurs que S1 – à échanger de façon sécurisée, pas par Git)
JWT_ALGORITHM=HS256
JWT_SECRET=shared-secret-from-S1
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ROLE_CLAIM=role

# Infrastructure partagée (serveur infra : RabbitMQ + Consul + Traefik)
RABBITMQ_URL=amqp://unitrack:change-me@INFRA_IP:5672/%2F
CONSUL_ENABLED=true
CONSUL_HOST=INFRA_IP
CONSUL_PORT=8500

# Identité de CETTE instance dans Consul : IP du serveur S4 joignable par Consul/Traefik
SERVICE_NAME=attendance-service
SERVICE_ADDRESS=SERVER4_IP
SERVICE_PORT=8004
TRAEFIK_PATH_PREFIX=/api/attendance

# Règles métier (optionnel)
ATTENDANCE_START_EARLY_MINUTES=15
TEACHER_ABSENCE_REFERENCE=end
TEACHER_ABSENCE_GRACE_MINUTES=0
AUTO_CLOSE_GRACE_MINUTES=30
CORS_ALLOW_ALL=false
GUNICORN_WORKERS=3
